# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Secrets ----------------------------------------------------------------
# Vite inlines every VITE_* value into the built bundle, so nothing secret
# belongs here — but the file still should not be committed, because that is
# how a secret eventually gets added by accident.
.env
.env.*
!.env.example

# --- Build output -----------------------------------------------------------
dist/
dist-ssr/
*.local

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches -----------------------------------------------------------------
.vite/
.eslintcache
coverage/

# --- Editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
