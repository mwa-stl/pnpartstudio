# Copy this file to .env and fill in the blanks.
#
# Vite inlines every VITE_* value into the built bundle, so treat them all as
# public. The PayPal client ID is designed to be public; the matching secret
# lives only in the server's .env and must never appear here.

# Where the API lives. Leave empty to fall back to http://localhost:4000.
VITE_API_URL=http://localhost:4000

# PayPal public client ID (sandbox or live, matching the server's PAYPAL_MODE).
VITE_PAYPAL_CLIENT_ID=

# WhatsApp number for the floating contact button — digits only, with country
# code, no "+" or spaces. Example: 17135769741
VITE_WHATSAPP_NUMBER=
