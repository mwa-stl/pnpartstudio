# Copy this file to .env and fill in the blanks. Never commit the real .env —
# it holds the database URI, the JWT secret, payment keys and the Google Cloud
# service-account key.

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5199
CURRENCY=USD

# --- Database ---------------------------------------------------------------
MONGODB_URI=

# --- Auth -------------------------------------------------------------------
# Random string of at least 32 characters — the server refuses to start with a
# shorter one. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating it signs every admin out.
JWT_SECRET=

# The admin session is an httpOnly cookie (the token is never given to page
# scripts). Production default is SameSite=None; Secure, which works when the
# console and API are on different sites but is blocked by browsers that refuse
# third-party cookies. If the console and API share a site (admin.example.com +
# api.example.com) set this to lax or strict: it is safer and always accepted.
COOKIE_SAMESITE=

# --- PayPal -----------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Required: webhook deliveries are rejected until this is set (they are verified with it).
PAYPAL_WEBHOOK_ID=

# --- Pricing (the server prices every order; the browser's numbers are ignored) --
# Orders under the threshold pay the flat shipping fee, in the order currency.
SHIPPING_FREE_THRESHOLD=100
SHIPPING_FEE=15

# --- Email (SMTP) -----------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Inbox that contact-form messages are delivered to.
CONTACT_TO=

# --- Google Cloud Storage (media) -------------------------------------------
# Bucket that holds every uploaded image and video. Required for uploads.
# The bucket needs allUsers → "Storage Object Viewer" for media to be readable.
GCP_PROJECT_ID=
GCP_BUCKET_NAME=

# Credentials — use EITHER a service-account key file...
GCP_KEY_FILE=
# ...OR inline credentials. Wrap the key in double quotes; it may span lines.
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=

# Serve media from a CDN or custom domain instead of storage.googleapis.com.
# Leave empty to use the default bucket URL.
GCS_PUBLIC_BASE_URL=

# --- Media processing --------------------------------------------------------
# Upload size caps, in megabytes.
MEDIA_MAX_IMAGE_MB=15
MEDIA_MAX_VIDEO_MB=200
# Visitor uploads (review photos, enquiry references) — deliberately smaller.
MEDIA_MAX_PUBLIC_IMAGE_MB=8
# Images are converted to WebP: longest edge in px, quality 1-100.
MEDIA_IMAGE_MAX_EDGE=2400
MEDIA_WEBP_QUALITY=82
# Ceiling for one stored still image, in KB. A 5 MB phone photo ends up at or
# under this: quality is stepped down, then dimensions, until it fits. 0 = off.
MEDIA_IMAGE_TARGET_KB=300
# Video is re-encoded to H.264 MP4: height cap, CRF (lower = better/bigger).
MEDIA_VIDEO_MAX_HEIGHT=720
MEDIA_VIDEO_CRF=28
MEDIA_VIDEO_AUDIO_BITRATE=128k
