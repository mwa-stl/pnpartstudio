# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Secrets ----------------------------------------------------------------
# Holds the Mongo URI, JWT secret, PayPal keys, SMTP password and the Google
# Cloud service-account key. Never commit it — commit .env.example instead.
.env
.env.*
!.env.example
*.pem
*.key
gcp-*.json
service-account*.json

