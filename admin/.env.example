# Copy this file to .env and fill in the blanks.
#
# Vite inlines every VITE_* value into the built bundle, so treat them all as
# public. Nothing secret belongs here — uploads and admin actions are
# authenticated by the server, not by anything stored in this file.

# Where the API lives. Leave empty to fall back to http://localhost:4000.
VITE_API_URL=http://localhost:4000
