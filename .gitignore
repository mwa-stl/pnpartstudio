# Repo-wide ignores. Each app also has its own .gitignore; this one is the
# safety net so a new folder can never quietly commit secrets or dependencies.

# --- Dependencies -----------------------------------------------------------
node_modules/
.pnp
.pnp.js
jspm_packages/

# --- Secrets ----------------------------------------------------------------
# Never commit real environment files. Commit .env.example instead, with the
# keys present and the values blank.
.env
.env.*
!.env.example
*.pem
*.key
# Google Cloud service-account keys.
gcp-*.json
service-account*.json

# --- Build output -----------------------------------------------------------
dist/
dist-ssr/
build/
out/
*.local

# --- Logs -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Caches -----------------------------------------------------------------
.cache/
.temp/
.tmp/
.vite/
coverage/
.eslintcache

# --- Editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
